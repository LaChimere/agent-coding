{
  "name": "evals",
  "version": "0.1.0",
  "description": "evals",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun -e \"import { rm } from 'node:fs/promises'; await rm('./dist', { recursive: true, force: true })\" && bun build ./src/index.ts --target bun --outfile ./dist/index.js",
    "check": "bun run typecheck && bun run lint",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "bun test --pass-with-no-tests",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "hooks": "LEFTHOOK_CONFIG=evals/lefthook.yml lefthook"
  },
  "keywords": [
    "bun",
    "typescript",
    "template"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "latest",
    "lefthook": "2.1.12",
    "typescript": "^6"
  },
  "peerDependencies": {}
}
