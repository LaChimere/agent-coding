export function eager(rows) {
  return rows.map(row => JSON.stringify(row)).join('\n') + '\n';
}

export function* lazy(rows) {
  for (const row of rows) {
    yield JSON.stringify(row) + '\n';
  }
}

export function batched(rows) {
  const chunks = [];
  const encoded = new Map();
  for (const row of rows) {
    if (!encoded.has(row)) {
      encoded.set(row, JSON.stringify(row));
    }
    chunks.push(encoded.get(row) + '\n');
  }
  return chunks.join('');
}

export function consume(value) {
  return typeof value === 'string' ? value : [...value].join('');
}
