from dataclasses import dataclass
from typing import Any
from uuid import uuid4


@dataclass(frozen=True)
class Lease:
    item_id: str
    token: str
    expires_at: int


@dataclass
class _Item:
    item_id: str
    payload: Any
    token: str | None = None
    expires_at: int | None = None


class InMemoryLeaseQueue:
    def __init__(self) -> None:
        self._items: list[_Item] = []

    def enqueue(self, item_id: str, payload: Any) -> None:
        self._items.append(_Item(item_id=item_id, payload=payload))

    def claim(self, *, now: int, lease_seconds: int) -> Lease | None:
        for item in self._items:
            if item.token is None or item.expires_at < now:
                item.token = uuid4().hex
                item.expires_at = now + lease_seconds
                return Lease(item.item_id, item.token, item.expires_at)
        return None

    def ack(self, item_id: str, token: str, *, now: int) -> bool:
        for item in self._items:
            if item.item_id != item_id:
                continue
            if item.token != token:
                return False
            self._items.remove(item)
            return True
        return False
