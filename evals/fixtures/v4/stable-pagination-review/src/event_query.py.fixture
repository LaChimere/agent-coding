def _key(row):
    return (row["created_at"], row["id"])

def events_page(records, after, limit):
    ordered = sorted(records, key=_key)
    if after is not None:
        ordered = [row for row in ordered if _key(row) > after]
    items = ordered[:limit]
    next_cursor = _key(items[-1]) if len(ordered) > len(items) else None
    return {"items": items, "next_cursor": next_cursor}
