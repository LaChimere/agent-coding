let currentRequestId: string | undefined;

export async function runWithRequest<T>(
  requestId: string,
  action: () => Promise<T>,
): Promise<T> {
  currentRequestId = requestId;
  try {
    return await action();
  } finally {
    currentRequestId = undefined;
  }
}

export function logRequest(
  logger: { info(record: Record<string, unknown>): void },
  message: string,
): void {
  logger.info({ requestId: currentRequestId, message });
}
