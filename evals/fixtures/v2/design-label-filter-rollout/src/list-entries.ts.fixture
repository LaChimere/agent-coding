export async function listEntries(actor: Actor, query: ListQuery, db: Database): Promise<Page<Entry>> {
  const predicates = ["tenant_id = $1"];
  const values: unknown[] = [actor.tenantId];
  if (query.ownerId !== undefined) {
    values.push(query.ownerId);
    predicates.push("owner_id = $" + values.length);
  }
  const rows = await db.query(
    "SELECT id, owner_id, labels, created_at FROM entries WHERE " + predicates.join(" AND ") + " ORDER BY created_at DESC LIMIT 100",
    values,
  );
  return page(rows);
}

export interface ListQuery { ownerId?: string; }
export interface Actor { tenantId: string; userId: string; }
